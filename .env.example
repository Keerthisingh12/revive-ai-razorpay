# ─── Database ─────────────────────────────────────────────────────────────────
# Default matches docker-compose.yml — change if using an external Postgres
DATABASE_URL="postgresql://reviveai:reviveai_secret@localhost:5432/reviveai_db"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── AI — Google Gemini ───────────────────────────────────────────────────────
# Optional. If not set, the app uses deterministic fallback diagnosis.
# Get a key at https://aistudio.google.com/app/apikey (free tier works)
# GEMINI_API_KEY=your_gemini_api_key_here

# ─── Guardrail Policy Defaults ────────────────────────────────────────────────
# These set the thresholds used by the guardrail engine.
# Override here without code changes.
DEFAULT_AUTO_ACTION_LIMIT=5000        # Auto-execute if amount < this (INR paise or units)
DEFAULT_HUMAN_APPROVAL_LIMIT=25000   # Hard ceiling — never auto-executed above this
DEFAULT_MAX_RETRIES=2                 # Block if transaction already retried this many times
DEFAULT_CONFIDENCE_THRESHOLD=0.70    # Escalate if AI confidence below this (0.0–1.0)

# ─── Razorpay Test Mode ───────────────────────────────────────────────────────
# NOT implemented in this submission — documented for future work.
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
