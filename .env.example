# Database
DATABASE_URL="postgresql://reviveai:reviveai_secret@localhost:5432/reviveai_db"

# Server
PORT=3001
NODE_ENV=development

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Merchant policy defaults (overridden per merchant in DB)
DEFAULT_AUTO_ACTION_LIMIT=5000
DEFAULT_HUMAN_APPROVAL_LIMIT=25000
DEFAULT_MAX_RETRIES=2
DEFAULT_CONFIDENCE_THRESHOLD=0.80

# Razorpay Test Mode (STRETCH GOAL — Day 5+ only, do not use earlier)
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
